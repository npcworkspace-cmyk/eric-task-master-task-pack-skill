{
  "schema": 1,
  "name": "youtube-creator-discovery",
  "version": "0.1.5",
  "platform": "youtube",
  "maturity": "portable-offline-validated",
  "taskmaster_contract": "taskmaster-task-module-v1",
  "required_capabilities": [
    "page",
    "input",
    "outputDir",
    "progress",
    "wait",
    "signal"
